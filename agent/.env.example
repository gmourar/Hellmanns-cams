# Mapeamento serial → cabine (obter via --smoke-test)
SERIAL_TO_CABINE=102031010975:1,102031010976:2,102031010977:3

API_BASE_URL=http://localhost:8000
AGENT_TOKEN=meu-token-secreto

# Saída vertical 9:16 (1080x1920). VIDEO_TRANSPOSE: 1=horário, 2=anti-horário
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
VIDEO_TRANSPOSE=1
FFMPEG_PRESET=veryfast
FFMPEG_CRF=24
FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
RECORD_DURATION=5.0
RECORD_PREP_DELAY=4.0
RECORD_START_SETTLE=3.5
VIDEO_SPEED=0.60
RAW_DIR=./processed

# Upload para S3 após processar (mesmo bucket/prefixo do backend)
UPLOAD_TO_S3=true
DELETE_LOCAL_AFTER_UPLOAD=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
S3_BUCKET=seu-bucket
S3_KEY_PREFIX=videos
S3_PUBLIC_URL=https://seu-bucket.s3.sa-east-1.amazonaws.com
