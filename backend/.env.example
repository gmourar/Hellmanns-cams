AGENT_TOKEN=meu-token-secreto
DATABASE_URL=sqlite+aiosqlite:///./hellmanns.db
VIDEO_DIR=../videos
BASE_URL=http://192.168.1.100:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# Armazenamento: local | s3
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
S3_BUCKET=seu-bucket
S3_KEY_PREFIX=videos
# URL pública (CloudFront ou https://bucket.s3.region.amazonaws.com)
S3_PUBLIC_URL=https://seu-bucket.s3.sa-east-1.amazonaws.com
# Gere URLs assinadas quando o bucket não for público
S3_PRESIGN_URLS=true
S3_URL_EXPIRES_SECONDS=86400

# Rekognition (região deve suportar o serviço — use us-east-1, não sa-east-1)
REKOGNITION_REGION=us-east-1
REKOGNITION_COLLECTION_ID=hellmanns-event
# URL base do frontend (para gerar QR genérico)
FRONTEND_BASE_URL=http://localhost:3000
